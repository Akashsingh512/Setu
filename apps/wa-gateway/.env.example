# Copy to apps/wa-gateway/.env (never commit it). Server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard > Project Settings > API keys > service_role / secret key.
# Full database access: keep it only here and in your host's secret settings.
SUPABASE_SERVICE_ROLE_KEY=
LOG_LEVEL=info

# --- Optional: Amazon Bedrock (AI classification of unclear messages) ---
# AI only decides what a message is asking; replies are always built from CRM data.
# Leave blank to use keyword rules only.
AWS_REGION=
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
