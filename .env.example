# Copy to apps/web/.env.local and apps/mobile/.env. Never commit real values.

# --- Public (safe to ship to browsers / mobile apps) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Web Push public key (the matching private key is an Edge Function secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only (Edge Function secrets: `supabase secrets set ...`) ---
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
# Never put it in a NEXT_PUBLIC_ / EXPO_PUBLIC_ variable.
EXPO_ACCESS_TOKEN=optional-expo-push-security-token
# Web Push keys for dispatch-push. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.example

# --- Tests ---
# Optional: a disposable Postgres (e.g. local `supabase start`) for the concurrency test.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
